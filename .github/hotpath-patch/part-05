+    );
+    assert_eq!(
+        Rule::AgeRangeCount {
+            min_age: 0,
+            max_age: 17,
+            min_count: 2,
+            max_count: 2,
+        }
+        .evaluate(&supervised),
+        Ok(false)
+    );
+    assert_eq!(
+        Rule::RequireGuardianForMinors {
+            minor_below_age: 18,
+        }
